{
    "version": 6,
    "configurePresets": [
        {
            "name": "host_debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "SERVIO_PLATFORM": "host",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
            }
        },
        {
            "name": "host_asan",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "SERVIO_PLATFORM": "host",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_C_FLAGS": "-fsanitize=address",
                "CMAKE_CXX_FLAGS": "-fsanitize=address -O0"
            }
        },
        {
            "name": "host_ubsan",
            "inherits": "host_debug",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all",
                "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all"
            }
        },
        {
            "name": "host_release",
            "inherits": "host_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "host_static",
            "inherits": "host_release",
            "cacheVariables": {
                "CMAKE_EXE_LINKER_FLAGS": "-static"
            }
        },
        {
            "name": "windows_debug",
            "inherits": "host_debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_COMPILER_LAUNCHER": ""
            }
        },
        {
            "name": "windows_release",
            "inherits": "windows_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "stm32h5_debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "SERVIO_PLATFORM": "stm32h5",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain/arm-none-eabi-gcc.cmake",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
            }
        },
        {
            "name": "stm32h5_release",
            "inherits": "stm32h5_debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host_debug",
            "configurePreset": "host_debug"
        },
        {
            "name": "host_asan",
            "configurePreset": "host_asan"
        },
        {
            "name": "host_ubsan",
            "configurePreset": "host_ubsan"
        },
        {
            "name": "host_release",
            "configurePreset": "host_release"
        },
        {
            "name": "host_static",
            "configurePreset": "host_static",
            "targets": [
                "scmdio"
            ]
        },
        {
            "name": "windows_debug",
            "configurePreset": "windows_debug"
        },
        {
            "name": "windows_release",
            "configurePreset": "windows_release"
        },
        {
            "name": "stm32h5_debug",
            "configurePreset": "stm32h5_debug"
        },
        {
            "name": "stm32h5_release",
            "configurePreset": "stm32h5_release"
        }
    ],
    "testPresets": [
        {
            "name": "host_debug",
            "configurePreset": "host_debug"
        },
        {
            "name": "host_asan",
